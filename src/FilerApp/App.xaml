<Application x:Class="FilerApp.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Light">
    <SolidColorBrush x:Key="FavoriteSectionBackgroundBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="ModifiedLastDayBrush" Color="#135F96"/><SolidColorBrush x:Key="ModifiedLastWeekBrush" Color="#36677E"/>
    <SolidColorBrush x:Key="ModifiedLastMonthBrush" Color="#526273"/><SolidColorBrush x:Key="ModifiedLastYearBrush" Color="#626B77"/>
    <SolidColorBrush x:Key="ModifiedOlderBrush" Color="#68717D"/><SolidColorBrush x:Key="ModifiedFutureBrush" Color="#526273"/><SolidColorBrush x:Key="ModifiedUnknownBrush" Color="#68717D"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="Dark">
    <SolidColorBrush x:Key="FavoriteSectionBackgroundBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ModifiedLastDayBrush" Color="#AAD8F5"/><SolidColorBrush x:Key="ModifiedLastWeekBrush" Color="#A5BBCD"/>
    <SolidColorBrush x:Key="ModifiedLastMonthBrush" Color="#A6AFBB"/><SolidColorBrush x:Key="ModifiedLastYearBrush" Color="#9BA3AE"/>
    <SolidColorBrush x:Key="ModifiedOlderBrush" Color="#9099A6"/><SolidColorBrush x:Key="ModifiedFutureBrush" Color="#A6AFBB"/><SolidColorBrush x:Key="ModifiedUnknownBrush" Color="#9099A6"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="HighContrast">
    <SolidColorBrush x:Key="FavoriteSectionBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
    <SolidColorBrush x:Key="ModifiedLastDayBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="ModifiedLastWeekBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="ModifiedLastMonthBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="ModifiedLastYearBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="ModifiedOlderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="ModifiedFutureBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="ModifiedUnknownBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
   </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Thickness x:Key="SurfacePadding">6</Thickness><CornerRadius x:Key="SurfaceRadius">4</CornerRadius>
  <x:Double x:Key="BodyFontSize">13</x:Double>
  <x:Double x:Key="FileRowHeight">28</x:Double>
  <x:Double x:Key="FileListCacheLength">0.5</x:Double>
  <x:Double x:Key="SmallFileIconSize">48</x:Double><x:Double x:Key="LargeFileIconSize">96</x:Double>
  <x:Double x:Key="SmallFileTileWidth">112</x:Double><x:Double x:Key="SmallFileTileHeight">104</x:Double>
  <x:Double x:Key="LargeFileTileWidth">144</x:Double><x:Double x:Key="LargeFileTileHeight">152</x:Double>
  <Style TargetType="Button"><Setter Property="CornerRadius" Value="3"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="FlatRowButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="2"/>
   <Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="6,0"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style x:Key="ColumnHeaderButton" TargetType="Button" BasedOn="{StaticResource FlatRowButton}"><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource FlatRowButton}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <Style x:Key="CompactNavigationButton" TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/></Style>
  <Style x:Key="FavoriteSectionRow" TargetType="Button" BasedOn="{StaticResource FlatRowButton}"><Setter Property="Background" Value="{ThemeResource FavoriteSectionBackgroundBrush}"/><Setter Property="CornerRadius" Value="0"/></Style>
  <Style x:Key="FooterViewToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="24"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="ViewModeButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
   <Setter Property="Width" Value="26"/><Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="6,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
