<Window x:Class="FilerApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:FilerApp.Views" Title="Nest Filer">
 <Grid x:Name="Root" Padding="5" RowSpacing="3" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <SolidColorBrush x:Key="TitleBarTextBrush" Color="{ThemeResource TextFillColorPrimary}"/>
   <SolidColorBrush x:Key="TitleBarInactiveTextBrush" Color="{ThemeResource TextFillColorSecondary}"/>
   <SolidColorBrush x:Key="TitleBarHoverBrush" Color="{ThemeResource NavigationHoverColor}"/>
   <SolidColorBrush x:Key="TitleBarPressedBrush" Color="{ThemeResource NavigationPressedColor}"/>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Workspace">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="210" MinWidth="140"/><ColumnDefinition x:Name="SidebarDividerColumn" Width="5"/><ColumnDefinition x:Name="CenterColumn" Width="*" MinWidth="360"/><ColumnDefinition x:Name="HistoryDividerColumn" Width="5"/><ColumnDefinition x:Name="HistoryColumn" Width="260" MinWidth="180"/></Grid.ColumnDefinitions>
   <Grid x:Name="LeftSidebar"><Grid.RowDefinitions><RowDefinition x:Name="FavoritesRow" Height="2*" MinHeight="80"/><RowDefinition Height="5"/><RowDefinition x:Name="LeftEmptyRow" Height="*" MinHeight="60"/></Grid.RowDefinitions>
    <Grid x:Name="FavoritesSurface" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid x:Name="FavoriteRootTarget" Padding="4,0"><TextBlock Text="お気に入り" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource NavigationButton}" Content="＋" HorizontalAlignment="Right" Click="AddGroup" ToolTipService.ToolTip="仮想フォルダを作成"/></Grid>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="FavoriteList" Spacing="0"/></ScrollViewer>
    </Grid>
    <views:ResizeGrip Grid.Row="1" Horizontal="True" DragDelta="ResizeLeftSections" AutomationProperties.Name="左ペイン上下の境界"/>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Padding="4,0"><TextBlock Text="場所" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource CompactNavigationButton}" HorizontalAlignment="Right" Click="RefreshPlaces" AutomationProperties.Name="ドライブとフォルダツリーを更新" ToolTipService.ToolTip="場所を更新"><FontIcon Glyph="&#xE72C;" FontSize="12"/></Button></Grid>
     <TreeView x:Name="PlacesTree" Grid.Row="1" FontSize="12" SelectionMode="Single" Expanding="ExpandPlace" ItemInvoked="OpenPlace">
      <TreeView.Resources><x:Double x:Key="TreeViewItemMinHeight">22</x:Double><x:Double x:Key="TreeViewItemContentHeight">18</x:Double><Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness><Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness></TreeView.Resources>
      <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="MinHeight" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></TreeView.ItemContainerStyle>
     </TreeView>
    </Grid>
   </Grid>
   <views:ResizeGrip x:Name="SidebarDivider" Grid.Column="1" DragDelta="ResizeSidebar" AutomationProperties.Name="左ペインの幅"/>
   <Grid Grid.Column="2">
    <Grid x:Name="Panes"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="320"/><ColumnDefinition x:Name="DividerColumn" Width="5"/><ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="320"/></Grid.ColumnDefinitions>
     <views:PaneView x:Name="LeftPane"/><views:ResizeGrip x:Name="PaneDivider" Grid.Column="1" DragDelta="ResizePanes" AutomationProperties.Name="AペインとBペインの境界"/><views:PaneView x:Name="RightPane" Grid.Column="2"/>
    </Grid>
   </Grid>
   <views:ResizeGrip x:Name="HistoryDivider" Grid.Column="3" DragDelta="ResizeHistory" AutomationProperties.Name="右ペインの幅"/>
   <Grid x:Name="RightSidebar" Grid.Column="4"><Grid.RowDefinitions><RowDefinition x:Name="RecentFilesRow" Height="*" MinHeight="80"/><RowDefinition Height="5"/><RowDefinition x:Name="RecentFoldersRow" Height="*" MinHeight="80"/></Grid.RowDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Padding="4,0"><TextBlock Text="最近開いたファイル" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource NavigationButton}" HorizontalAlignment="Right" Click="ClearRecentFiles" AutomationProperties.Name="ファイル履歴を消去" ToolTipService.ToolTip="ファイル履歴を消去"><FontIcon Glyph="&#xE74D;" FontSize="12"/></Button></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RecentFilesList" Spacing="0"/></ScrollViewer></Grid>
    <views:ResizeGrip Grid.Row="1" Horizontal="True" DragDelta="ResizeRightSections" AutomationProperties.Name="右ペイン上下の境界"/>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Padding="4,0"><TextBlock Text="最近開いたフォルダ" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource NavigationButton}" HorizontalAlignment="Right" Click="ClearRecentFolders" AutomationProperties.Name="フォルダ履歴を消去" ToolTipService.ToolTip="フォルダ履歴を消去"><FontIcon Glyph="&#xE74D;" FontSize="12"/></Button></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RecentFoldersList" Spacing="0"/></ScrollViewer></Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,1,0,0">
   <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Status" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock x:Name="ActiveLabel" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" AutomationProperties.Name="画面レイアウト">
     <ToggleButton x:Name="LeftSidebarToggle" Style="{StaticResource FooterViewToggle}" IsChecked="True" Click="ToggleSidebar" AutomationProperties.Name="左サイドバーの表示切替" ToolTipService.ToolTip="左サイドバーを表示／非表示（お気に入り・場所）"><Grid Width="16" Height="14"><Path Stroke="{Binding Foreground, ElementName=LeftSidebarToggle}" StrokeThickness="1" Data="M1,1H15V13H1Z M5,1V13"/><Path Fill="{Binding Foreground, ElementName=LeftSidebarToggle}" Opacity="0.35" Data="M1,1H5V13H1Z"/></Grid></ToggleButton>
     <ToggleButton x:Name="SinglePaneToggle" Style="{StaticResource FooterViewToggle}" Click="ChoosePaneLayout" AutomationProperties.Name="Aペインのみ表示" ToolTipService.ToolTip="Aペインのみ表示"><Grid Width="16" Height="14"><Path Stroke="{Binding Foreground, ElementName=SinglePaneToggle}" StrokeThickness="1" Data="M1,1H15V13H1Z"/><TextBlock Text="A" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ToggleButton>
     <ToggleButton x:Name="DualToggle" Style="{StaticResource FooterViewToggle}" IsChecked="True" Click="ChoosePaneLayout" AutomationProperties.Name="AとBを左右分割表示" ToolTipService.ToolTip="A / B ペインを左右に分割"><Grid Width="20" Height="14"><Path Stroke="{Binding Foreground, ElementName=DualToggle}" StrokeThickness="1" Data="M1,1H19V13H1Z M10,1V13"/><TextBlock Text="A" FontSize="8" Margin="3,0,0,0" VerticalAlignment="Center"/><TextBlock Text="B" FontSize="8" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></ToggleButton>
     <ToggleButton x:Name="RightSidebarToggle" Style="{StaticResource FooterViewToggle}" IsChecked="True" Click="ToggleSidebar" AutomationProperties.Name="右サイドバーの表示切替" ToolTipService.ToolTip="右サイドバーを表示／非表示（最近開いた項目）"><Grid Width="16" Height="14"><Path Stroke="{Binding Foreground, ElementName=RightSidebarToggle}" StrokeThickness="1" Data="M1,1H15V13H1Z M11,1V13"/><Path Fill="{Binding Foreground, ElementName=RightSidebarToggle}" Opacity="0.35" Data="M11,1H15V13H11Z"/></Grid></ToggleButton>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
