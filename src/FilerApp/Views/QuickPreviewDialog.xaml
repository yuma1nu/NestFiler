<ContentDialog x:Class="FilerApp.Views.QuickPreviewDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="クイックプレビュー" PrimaryButtonText="関連付けアプリで開く" CloseButtonText="閉じる" DefaultButton="None" PrimaryButtonClick="OpenExternal">
 <Grid x:Name="PreviewContent" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Style="{StaticResource NavigationButton}" Click="Previous" AutomationProperties.Name="前の項目" ToolTipService.ToolTip="前の項目 (Alt+←)"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button>
   <Button Grid.Column="1" Style="{StaticResource NavigationButton}" Click="Next" AutomationProperties.Name="次の項目" ToolTipService.ToolTip="次の項目 (Alt+→)"><FontIcon Glyph="&#xE72A;" FontSize="14"/></Button>
   <TextBlock x:Name="PreviewPath" Grid.Column="2" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <ComboBox x:Name="PreviewEncoding" Grid.Column="3" Width="100" MinHeight="28" Height="28" Padding="6,0" FontSize="12" SelectionChanged="PreviewEncodingChanged" AutomationProperties.Name="プレビューの文字コード"><x:String>UTF-8</x:String><x:String>CP932</x:String></ComboBox>
  </Grid>
  <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image x:Name="PreviewImage" Stretch="Uniform"/><ScrollViewer x:Name="TextPreview" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></Grid>
  <TextBlock x:Name="PreviewInfo" Grid.Row="2" FontSize="12" TextWrapping="Wrap" MaxHeight="68" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </Grid>
</ContentDialog>
